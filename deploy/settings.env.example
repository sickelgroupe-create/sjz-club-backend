# Copy outside the repository to /etc/sjz-club/settings.env. Fill private values there.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8082
RUOYI_PROFILE=/var/lib/sjz-club/uploads
LOG_PATH=/var/log/sjz-club
DB_URL='jdbc:mysql://127.0.0.1:3306/sjz_club?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true'
DB_USERNAME=sjz_app
DB_PASSWORD=CHANGE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME
TOKEN_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
CLUB_IDENTITY_ENCRYPTION_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS
PUBLIC_API_BASE=https://api.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
PAYMENT_MODE=disabled
PHONE_AUTH_MODE=disabled
WECHAT_LOGIN_MODE=disabled
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/pay/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/pay/wechat/refund-notify
VIRTUAL_PAYMENT_ENABLED=false
VIRTUAL_PAYMENT_ENV=1
VIRTUAL_PAYMENT_OFFER_ID=
VIRTUAL_PAYMENT_SANDBOX_APP_KEY=
VIRTUAL_PAYMENT_LIVE_APP_KEY=
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
SWAGGER_ENABLED=false
DRUID_STAT_ENABLED=false
LOG_LEVEL=info

